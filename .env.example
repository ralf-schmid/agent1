# Mastodon Konfiguration
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_access_token_here

# Scheduling
POST_TIME=06:00
TIMEZONE=Europe/Berlin

# Bibel
BIBLE_TRANSLATION=ELB
BIBLE_SERVER_BASE_URL=https://www.bibleserver.com

# Losungen
LOSUNGEN_FILE=data/

# Gottesdienst-Erinnerung (Samstag 17:00)
CHURCH_REMINDER_ENABLED=true
CHURCH_REMINDER_TIME=17:00
CHURCH_REMINDER_DAY=5  # 0=Mo, 5=Sa, 6=So

# Follower-Interaktionen
AUTO_FOLLOW_BACK=true
WELCOME_MESSAGE_ENABLED=true
FOLLOWER_CHECK_TIME=08:00  # Täglich um 08:00 Uhr
FOLLOWER_STATE_FILE=data/follower_state.json

# Admin-Benachrichtigungen (optional)
ADMIN_NOTIFY_ACCOUNT=ralf_schmid@chaos.social

# Podcast-Links
PODCAST_APPLE=https://podcasts.apple.com/de/podcast/die-losungen/id1434728607
PODCAST_SPOTIFY=https://open.spotify.com/show/12L3SnnMI5JMDJVtQCqBxh

# Bibelquiz (wöchentlich, benötigt Anthropic API)
QUIZ_ENABLED=false  # Aktivieren wenn API-Key gesetzt
QUIZ_DAY=2  # 0=Mo, 2=Mi, 6=So
QUIZ_TIME=18:00
QUIZ_POLL_DURATION=86400  # 24 Stunden in Sekunden
QUIZ_STATE_FILE=data/quiz_state.json
ANTHROPIC_API_KEY=  # Für Quiz-Generierung mit Claude
